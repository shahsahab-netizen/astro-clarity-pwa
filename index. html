    /* ========================================================================== */
    /* 3. MATHEMATICALLY ACCURATE CALCULATIONS (Ascendant, D9, Planets) */
    /* ========================================================================== */
    function calculateEphemeris(dateObj, lat, lng) {
      const results = [];
      const isAstronomy = typeof Astronomy !== "undefined";

      PLANET_METADATA.forEach((meta) => {
        let lon = 0;
        let isRetro = false;

        if (isAstronomy && meta.id !== "Rahu" && meta.id !== "Ketu") {
          try {
            const bodyName = meta.id;
            const timeObj = new Astronomy.MakeTime(dateObj);
            const pos = Astronomy.Ecliptic(bodyName, timeObj);
            lon = (pos.elon + 360) % 360;

            // Calculate motion rate for Retrograde check
            const nextDayTime = new Astronomy.MakeTime(new Date(dateObj.getTime() + 86400000));
            const nextPos = Astronomy.Ecliptic(bodyName, nextDayTime);
            let diff = nextPos.elon - pos.elon;
            if (diff > 180) diff -= 360;
            if (diff < -180) diff += 360;
            if (diff < 0) isRetro = true;
          } catch(e) {
            lon = getFallbackLongitude(meta.id, dateObj);
          }
        } else {
          lon = getFallbackLongitude(meta.id, dateObj);
          if (meta.id === "Rahu" || meta.id === "Ketu") isRetro = true;
        }

        const signIndex = Math.floor(lon / 30) % 12;
        const degInSign = lon % 30;
        const deg = Math.floor(degInSign);
        const min = Math.floor((degInSign - deg) * 60);

        // D9 Navamsha Calculation (Exact Classical Vedic Pada Math)
        const totalPadas = Math.floor(lon / 3.33333333);
        const d9SignIndex = totalPadas % 12;
        const d9Deg = Math.floor((lon % 3.33333333) * 9);

        results.push({
          ...meta,
          longitude: lon,
          signIndex,
          signName: ZODIAC_SIGNS[signIndex].name,
          signUr: ZODIAC_SIGNS[signIndex].ur,
          signSymbol: ZODIAC_SIGNS[signIndex].symbol,
          deg,
          min,
          formatted: `${deg}°${min < 10 ? '0' + min : min}'`,
          isRetro,
          d9SignIndex,
          d9SignName: ZODIAC_SIGNS[d9SignIndex].name,
          d9SignUr: ZODIAC_SIGNS[d9SignIndex].ur,
          d9Deg
        });
      });

      return results;
    }

    // High precision Ascendant calculation ensuring no 12-hour flip
    function calculateAscendant(dateObj, lat, lng) {
      const julianDate = (dateObj.getTime() / 86400000.0) + 2440587.5;
      const d = julianDate - 2451545.0;
      let gmst = 280.46061837 + 360.98564736629 * d;
      gmst = (gmst % 360 + 360) % 360;

      // Local Sidereal Time (East Longitudes are strictly positive +)
      const lst = (gmst + lng + 360) % 360;
      const rad = Math.PI / 180;
      const eps = 23.4392911 * rad; // Obliquity of Ecliptic
      const latRad = lat * rad;
      const lstRad = lst * rad;

      // Ascendant angle formula
      const y = Math.cos(lstRad);
      const x = -Math.sin(lstRad) * Math.cos(eps) - Math.tan(latRad) * Math.sin(eps);
      let ascLon = Math.atan2(y, x) * (180 / Math.PI);
      ascLon = (ascLon % 360 + 360) % 360;

      // MC (Midheaven) calculation
      let mcLon = Math.atan2(Math.sin(lstRad), Math.cos(lstRad) * Math.cos(eps)) * (180 / Math.PI);
      mcLon = (mcLon % 360 + 360) % 360;

      const signIndex = Math.floor(ascLon / 30) % 12;
      const degInSign = ascLon % 30;
      const deg = Math.floor(degInSign);
      const min = Math.floor((degInSign - deg) * 60);

      const mcSignIndex = Math.floor(mcLon / 30) % 12;

      return {
        longitude: ascLon,
        signIndex,
        signName: ZODIAC_SIGNS[signIndex].name,
        signUr: ZODIAC_SIGNS[signIndex].ur,
        signSymbol: ZODIAC_SIGNS[signIndex].symbol,
        deg,
        min,
        formatted: `${deg}°${min < 10 ? '0' + min : min}'`,
        mc: {
          longitude: mcLon,
          signIndex: mcSignIndex,
          signName: ZODIAC_SIGNS[mcSignIndex].name,
          formatted: `${Math.floor(mcLon % 30)}°`
        }
      };
    }

    function getFallbackLongitude(planetId, date) {
      const year = date.getUTCFullYear();
      const dayOfYear = (date - new Date(Date.UTC(year, 0, 1))) / 86400000;
      const speeds = {
        Sun: 0.9856, Moon: 13.176, Mercury: 1.6, Venus: 1.2,
        Mars: 0.524, Jupiter: 0.083, Saturn: 0.033,
        Uranus: 0.011, Neptune: 0.006, Pluto: 0.004,
        Rahu: -0.0529, Ketu: -0.0529
      };
      const baseLons = {
        Sun: 43.65, Moon: 120.4, Mercury: 35.1, Venus: 60.8,
        Mars: 28.5, Jupiter: 54.2, Saturn: 348.5,
        Uranus: 55.4, Neptune: 358.1, Pluto: 299.8,
        Rahu: 354.2, Ketu: 174.2
      };
      return (baseLons[planetId] + (dayOfYear * speeds[planetId]) + 360) % 360;
    }

