    /* 5. DUAL-WHEEL SVG COMPONENT (Natal Inner, Transits Outer) */
    /* ========================================================================== */
    function DualWheelSVG({ natal, transits, ascendant, view }) {
      const size = 520;
      const center = size / 2;
      const rOuter = 240;
      const rTransit = 195;
      const rNatal = 145;
      const rInner = 85;

      // Ascendant angle offset for house rotation
      let baseOffset = ascendant ? ascendant.longitude : 0;
      if (view === "Moon") {
        const moon = natal.find(p => p.id === "Moon");
        if (moon) baseOffset = moon.longitude;
      } else if (view === "Sun") {
        const sun = natal.find(p => p.id === "Sun");
        if (sun) baseOffset = sun.longitude;
      }

      return (
        <svg width={size} height={size} viewBox={`0 0 ${size} ${size}`} className="max-w-full h-auto">
          {/* Background circles */}
          <circle cx={center} cy={center} r={rOuter} fill="#fdfbf7" stroke="#e2e8f0" strokeWidth="2" />
          <circle cx={center} cy={center} r={rTransit} fill="#ffffff" stroke="#cbd5e1" strokeWidth="1.5" />
          <circle cx={center} cy={center} r={rNatal} fill="#f8fafc" stroke="#94a3b8" strokeWidth="1.5" />
          <circle cx={center} cy={center} r={rInner} fill="#ffffff" stroke="#e2e8f0" strokeWidth="1" />

          {/* 12 Zodiac Houses / Spokes */}
          {Array.from({ length: 12 }).map((_, idx) => {
            const angleDeg = idx * 30 - baseOffset;
            const angleRad = (angleDeg * Math.PI) / 180;
            const x1 = center + rInner * Math.cos(angleRad);
            const y1 = center + rInner * Math.sin(angleRad);
            const x2 = center + rOuter * Math.cos(angleRad);
            const y2 = center + rOuter * Math.sin(angleRad);

            // Zodiac label coordinates
            const midAngle = ((idx * 30 + 15 - baseOffset) * Math.PI) / 180;
            const signX = center + (rOuter - 18) * Math.cos(midAngle);
            const signY = center + (rOuter - 18) * Math.sin(midAngle);
            const sign = ZODIAC_SIGNS[idx];

            return (
              <g key={idx}>
                <line x1={x1} y1={y1} x2={x2} y2={y2} stroke="#e2e8f0" strokeWidth="1" />
                <text
                  x={signX}
                  y={signY}
                  textAnchor="middle"
                  dominantBaseline="central"
                  fontSize="13"
                  fontWeight="bold"
                  fill="#475569"
                >
                  {sign.symbol}
                </text>
              </g>
            );
          })}

          {/* Outer Ring: Current Transits */}
          {transits.map((p, i) => {
            const angle = ((p.longitude - baseOffset) * Math.PI) / 180;
            const radius = rTransit - 18;
            const x = center + radius * Math.cos(angle);
            const y = center + radius * Math.sin(angle);

            return (
              <g key={`t-${p.id}`} transform={`translate(${x}, ${y})`}>
                <circle cx="0" cy="0" r="10" fill="#ffffff" stroke={p.color} strokeWidth="1.5" />
                <text
                  x="0"
                  y="1"
                  textAnchor="middle"
                  dominantBaseline="central"
                  fontSize="9"
                  fontWeight="bold"
                  fill={p.color}
                >
                  {p.abbrev}
                </text>
                {p.isRetro && (
                  <text x="7" y="-5" fontSize="8" fontWeight="bold" fill="#dc2626">R</text>
                )}
              </g>
            );
          })}

          {/* Inner Ring: Natal Planets (or D9 if selected) */}
          {natal.map((p, i) => {
            const planetLon = view === "D9" ? (p.d9SignIndex * 30 + p.d9Deg) : p.longitude;
            const angle = ((planetLon - baseOffset) * Math.PI) / 180;
            const radius = rNatal - 20;
            const x = center + radius * Math.cos(angle);
            const y = center + radius * Math.sin(angle);

            return (
              <g key={`n-${p.id}`} transform={`translate(${x}, ${y})`}>
                <circle cx="0" cy="0" r="12" fill={p.color} />
                <text
                  x="0"
                  y="1"
                  textAnchor="middle"
                  dominantBaseline="central"
                  fontSize="9"
                  fontWeight="bold"
                  fill="#ffffff"
                >
                  {p.abbrev}
                </text>
                <text
                  x="0"
                  y="18"
                  textAnchor="middle"
                  fontSize="8"
                  fontWeight="bold"
                  fill="#0f172a"
                >
                  {view === "D9" ? `${p.d9Deg}°` : p.formatted}
                </text>
              </g>
            );
          })}

          {/* Ascendant Line & Arrow */}
          <line
            x1={center - rOuter}
            y1={center}
            x2={center + rOuter}
            y2={center}
            stroke="#d97706"
            strokeWidth="1.5"
            strokeDasharray="4 2"
          />
          <text x={center - rOuter + 22} y={center - 6} fill="#d97706" fontSize="10" fontWeight="bold">
            AC {ascendant?.formatted}
          </text>
        </svg>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
